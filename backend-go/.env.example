# --- Server ---
PORT=3001

# --- Authentication ---
# Required. Use a long random string in production.
JWT_SECRET=

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=publish_db
DB_SSLMODE=disable

# --- IPFS / Pinata ---
# Leave empty to use mock CID (no real upload).
PINATA_JWT=

# --- Ethereum / Smart Contracts ---
# Private key (hex, with or without 0x prefix) of the operator wallet.
# Leave empty to disable on-chain submission (returns mock tx hash).
OPERATOR_PRIVATE_KEY=

# HTTP RPC used for transaction broadcasting and indexer fallback polling.
RPC_URL=http://127.0.0.1:8545

# WebSocket RPC used by the indexer for live event subscriptions.
# Leave empty to fall back to HTTP polling.
INDEXER_RPC_WSS=

# Deployed contract addresses. Set to zero address to disable.
REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
REVIEW_ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
DOI_TOKEN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Block number to start indexing from (0 = genesis).
INDEXER_START_BLOCK=0

# How often to poll for new blocks when using HTTP (milliseconds).
INDEXER_POLL_INTERVAL_MS=5000

# --- Identity Verification ---
# OAuth client ID from Google Cloud Console. Leave empty to disable
# /users/identity-verify (Google ID token audience check always fails).
GOOGLE_CLIENT_ID=