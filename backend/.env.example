# --- Server Configuration ---
PORT=3001

# --- Authentication ---
JWT_SECRET=super-secret-jwt-key-replace-in-production

# --- IPFS / Pinata (Storage) ---
PINATA_JWT=your_pinata_jwt_token_here

# --- Web3 / Smart Contract Integration ---
# Private key of the operator account that broadcasts manuscript submissions
OPERATOR_PRIVATE_KEY= your_operator_private_key_here
# RPC URL for the target blockchain network
RPC_URL=http://127.0.0.1:8545
# Address of the deployed PublicationRegistry smart contract
REGISTRY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
