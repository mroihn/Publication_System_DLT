# ─── Network ───
# Polygon Amoy RPC URL (WebSocket required for event listening)
AMOY_RPC_WSS=wss://polygon-amoy-bor-rpc.publicnode.com
# HTTP fallback for transaction sending
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# ─── Oracle Operator ───
# Private key of the account with ORACLE_ROLE on ReviewOracle (without 0x prefix)
ORACLE_PRIVATE_KEY=

# ─── Contract Addresses ───
# ReviewOracle contract address (deployed via smartcontract/scripts/deploy.js)
REVIEW_ORACLE_ADDRESS=

# ─── Plagiarism API ───
# Endpoint for plagiarism checking. The oracle will POST { cid: "..." } and
# expect a JSON response with { score: 0-100 }.
# Leave empty to use the built-in mock that returns a random score.
PLAGIARISM_API_URL=

# ─── Optional ───
# Polling interval in ms for HTTP provider fallback (default: 5000)
POLL_INTERVAL_MS=5000
