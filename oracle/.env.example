# ─── Network ───
# Ethereum Sepolia RPC URL (WebSocket preferred for real-time event streaming)
SEPOLIA_RPC_WSS=wss://ethereum-sepolia-rpc.publicnode.com
# HTTP fallback for transaction sending
SEPOLIA_RPC_URL=https://rpc.ankr.com/eth_sepolia

# ─── Oracle Operator ───
# Private key of the account with ORACLE_ROLE on ReviewOracle (without 0x prefix)
ORACLE_PRIVATE_KEY=

# ─── Contract Addresses ───
# ReviewOracle contract address (deployed via smartcontract/scripts/deploy.js)
REVIEW_ORACLE_ADDRESS=

# ─── Plagiarism API ───
# Endpoint for plagiarism checking. The oracle will POST { cid: "..." } and
# expect a JSON response with { score: 0-100 }.
# Leave empty to use the built-in mock that returns a repeatable score.
PLAGIARISM_API_URL=

# ─── Reviewer Selection ───
# Number of reviewers to select per manuscript.
# MUST be an odd number ≥ 3 (default: 3).
NUM_REVIEWERS=3

# Reviewer addresses by competency tier.
# These MUST match accounts that have been granted REVIEWER_ROLE on-chain.
#
# HIGH tier — domain experts / senior researchers
REVIEWER_HIGH_1=0x0000000000000000000000000000000000000001
REVIEWER_HIGH_2=0x0000000000000000000000000000000000000002
REVIEWER_HIGH_3=0x0000000000000000000000000000000000000003

# MEDIUM tier — mid-career researchers
REVIEWER_MEDIUM_1=0x0000000000000000000000000000000000000004
REVIEWER_MEDIUM_2=0x0000000000000000000000000000000000000005
REVIEWER_MEDIUM_3=0x0000000000000000000000000000000000000006
REVIEWER_MEDIUM_4=0x0000000000000000000000000000000000000007

# LOW tier — junior researchers / PhD candidates
REVIEWER_LOW_1=0x0000000000000000000000000000000000000008
REVIEWER_LOW_2=0x0000000000000000000000000000000000000009
REVIEWER_LOW_3=0x000000000000000000000000000000000000000a

# ─── Optional ───
# Polling interval in ms for HTTP provider fallback (default: 5000)
POLL_INTERVAL_MS=5000
